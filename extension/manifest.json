{
  "manifest_version": 3,
  "name": "FB Group Search",
  "version": "1.0.0",
  "description": "Quét bài viết Facebook Group, tìm khách hàng tiềm năng từ từ khoá",
  "author": "StrongDinh",
  "homepage_url": "https://strongdinh.github.io/fb-group-search/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.facebook.com/groups/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["*://www.facebook.com/groups/*"]
}
